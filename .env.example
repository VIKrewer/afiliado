TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Open API do programa de AFILIADOS (não é a API de vendedores).
SHOPEE_APP_ID=
SHOPEE_SECRET=
# Opcional: autenticação Bearer de um feed JSON autorizado.
FEED_TOKEN=
# URL HTTPS pública do FRONTEND (sem barra final), usada nos links /r/...
PUBLIC_APP_URL=
# Para produção: configure as quatro variáveis abaixo e execute supabase/setup.sql.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SETTINGS_ENCRYPTION_KEY=
# Usuário que pode usar as chaves Telegram/Gemini do .env em produção.
# Outros usuários configuram as próprias chaves pelo painel.
SUPABASE_ADMIN_USER_ID=
API_PORT=3001
API_HOST=127.0.0.1
